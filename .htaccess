# mitothrum.com — this is the site's own folder, public_html/mitothrum.com.
# The parent public_html belongs to waterdamagegwinnett.com, which has its own
# .htaccess; nothing here touches it.
RewriteEngine On

# One canonical address: https://mitothrum.com
RewriteCond %{HTTP_HOST} ^www\.mitothrum\.com$ [NC]
RewriteRule ^(.*)$ https://mitothrum.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^mitothrum\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://mitothrum.com/$1 [R=301,L]

# /index.html goes to / (matched on the original request so the server's
# own DirectoryIndex lookup never loops)
RewriteCond %{HTTP_HOST} ^mitothrum\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:[^/\s?]+/)*)index\.html[\s?] [NC]
RewriteRule ^ https://mitothrum.com/%1 [R=301,L]

# Only mitothrum.com serves this folder. It sits inside the parent public_html,
# so waterdamagegwinnett.com/mitothrum.com/ would otherwise show a second copy
# of this site. Any other hostname gets a 404, which keeps the two live sites
# separate.
RewriteCond %{HTTP_HOST} !^(www\.)?mitothrum\.com(:[0-9]+)?$ [NC]
RewriteRule ^ - [R=404,L]

# Security headers: https only for a year, no framing by other sites, no MIME
# sniffing, limited referrer details on outbound clicks, and no camera,
# microphone, location or payment access for any page. Both sites send the
# same set (this file's copy also reaches anything inside its folder).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Full Content Security Policy (tested Oct 29, 2026 on every page with zero
  # violations): scripts, styles, fonts and analytics only from this site,
  # Google Fonts and Google Analytics; no plugins, no framing, no form posts
  # to other sites. Add a domain here before embedding anything new.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Pages and feeds must be revalidated, so a deploy shows up immediately
# instead of an old cached copy. Images keep normal caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Notes, archives, backups and deploy state are never public. The server folder
# holds old upload zips (~1 GB), index backups and notes from manual uploads;
# this keeps them from being downloadable without deleting anything.
<FilesMatch "(\.(md|zip)|-backup-.*\.html|^\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

# An old copy of the site sits in a "mitothrum" subfolder from earlier manual
# uploads; don't serve it as duplicate content.
RedirectMatch 404 ^/mitothrum(/.*)?$

# _to_delete/ holds server files queued for the owner to delete in cPanel.
# Scripts and generator metadata never belong on the public site either.
RedirectMatch 404 ^/_to_delete(/.*)?$
<FilesMatch "\.(py|sh)$">
  Require all denied
</FilesMatch>
