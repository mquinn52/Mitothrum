# mitothrum.com — this is the site's own folder, public_html/mitothrum.com.
# The parent public_html belongs to waterdamagegwinnett.com, which has its own
# .htaccess; nothing here touches it.
RewriteEngine On

# One canonical address: https://mitothrum.com
RewriteCond %{HTTP_HOST} ^www\.mitothrum\.com$ [NC]
RewriteRule ^(.*)$ https://mitothrum.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^mitothrum\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://mitothrum.com/$1 [R=301,L]

# Only mitothrum.com serves this folder. It sits inside the parent public_html,
# so waterdamagegwinnett.com/mitothrum.com/ would otherwise show a second copy
# of this site. Any other hostname gets a 404, which keeps the two live sites
# separate.
RewriteCond %{HTTP_HOST} !^(www\.)?mitothrum\.com(:[0-9]+)?$ [NC]
RewriteRule ^ - [R=404,L]

# Pages and feeds must be revalidated, so a deploy shows up immediately
# instead of an old cached copy. Images keep normal caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Notes, archives, backups and deploy state are never public. The server folder
# holds old upload zips (~1 GB), index backups and notes from manual uploads;
# this keeps them from being downloadable without deleting anything.
<FilesMatch "(\.(md|zip)|-backup-.*\.html|^\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

# An old copy of the site sits in a "mitothrum" subfolder from earlier manual
# uploads; don't serve it as duplicate content.
RedirectMatch 404 ^/mitothrum(/.*)?$
